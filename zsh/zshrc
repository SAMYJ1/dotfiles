export PATH=$PATH:/opt/homebrew/bin
export ZSH="$HOME/.oh-my-zsh"
export XDG_CONFIG_HOME="$HOME/.config"

# Keep terminal identity aligned with the actual emulator.
# Ghostty needs its bundled terminfo, while Terminal.app/iTerm should not
# advertise Ghostty's TERM value.
GHOSTTY_TERMINFO_DIR="/Applications/Ghostty.app/Contents/Resources/terminfo"
case "${TERM_PROGRAM:-}" in
  Ghostty|ghostty)
    if [[ "${TERM:-}" == "xterm-ghostty" && -d "$GHOSTTY_TERMINFO_DIR" ]]; then
      export TERMINFO="$GHOSTTY_TERMINFO_DIR"
    fi
    ;;
  Apple_Terminal|iTerm.app)
    if [[ "${TERM:-}" == "xterm-ghostty" ]]; then
      export TERM="xterm-256color"
    fi
    if [[ "${TERMINFO:-}" == "$GHOSTTY_TERMINFO_DIR" ]]; then
      unset TERMINFO
    fi
    ;;
esac

# SSH does not forward TERM_PROGRAM, but it does preserve TERM. If the client
# advertises Ghostty, make sure the remote shell can find Ghostty's terminfo.
if [[ "${TERM:-}" == "xterm-ghostty" && -z "${TERMINFO:-}" && -d "$GHOSTTY_TERMINFO_DIR" ]]; then
  export TERMINFO="$GHOSTTY_TERMINFO_DIR"
fi

# disable oh-my-zsh themes for pure prompt
ZSH_THEME=""
ZSH_DISABLE_COMPFIX=true

# zsh plugins
plugins=(git)

source $ZSH/oh-my-zsh.sh
# oh-my-zsh config end

fpath+=("$(brew --prefix)/share/zsh/site-functions")

export BREW_HOME=$(brew --prefix)

export ZPLUG_HOME=$BREW_HOME/opt/zplug
source $ZPLUG_HOME/init.zsh
zplug "mafredri/zsh-async", from:github
zplug "sindresorhus/pure", use:pure.zsh, from:github, as:theme
zplug "zdharma/fast-syntax-highlighting", as:plugin, defer:2
zplug "zsh-users/zsh-autosuggestions", as:plugin, defer:2
if [[ -z "$NVIM" ]]; then
    zplug "jeffreytse/zsh-vi-mode"
fi
zplug load

# Keep startup non-interactive and fast. Run this manually when maintaining
# plugins instead of checking/updating on every new shell.
zplug-maintain() {
    zplug check --verbose || zplug install
    zplug update
}

zstyle :prompt:pure:git:branch color green

export LC_ALL=en_US.UTF-8  
export LANG=en_US.UTF-8

# proxy list
PROXY="https_proxy=http://127.0.0.1:7890 http_proxy=http://127.0.0.1:7890 all_proxy=socks5://127.0.0.1:7890"
alias proxy="export $PROXY"
alias unproxy='unset all_proxy http_proxy https_proxy'

export EDITOR=nvim
alias vim='nvim'
alias v='nvim'
alias t='tmux'
alias zz='yazi'
alias gg=lazygit
if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init zsh)"
fi

# fzf integration: key bindings/completion plus fd/bat-powered defaults when
# available. Falls back cleanly if fd or bat are not installed.
if command -v fd >/dev/null 2>&1; then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --strip-cwd-prefix'
else
    export FZF_DEFAULT_COMMAND='find . -type f -not -path "*/.git/*" -print'
fi
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:-} --height=60% --layout=reverse --border=rounded --preview-window=right:65%:wrap:border-left"
if command -v bat >/dev/null 2>&1; then
    export FZF_CTRL_T_OPTS="${FZF_CTRL_T_OPTS:-} --preview 'bat --color=always --style=plain,numbers --line-range=:500 {}'"
fi
if [[ -o interactive && -t 0 ]]; then
    if [[ -f /opt/homebrew/opt/fzf/shell/key-bindings.zsh ]]; then
        source /opt/homebrew/opt/fzf/shell/key-bindings.zsh
    fi
    if [[ -f /opt/homebrew/opt/fzf/shell/completion.zsh ]]; then
        source /opt/homebrew/opt/fzf/shell/completion.zsh
    fi
fi

